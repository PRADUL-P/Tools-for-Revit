<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📏 BIMToolkit — Level Creator"
        Height="620" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E4E8"/>
            <Setter Property="Foreground" Value="#24292E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#D9381E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Standard Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📏 Batch Level Creator" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock Text="Create multiple levels from a reference level with uniform or custom offsets." FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Reference Level Selection -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Reference Base Level:" Style="{StaticResource FieldLabel}"/>
                <ComboBox Name="RefLevelCombo" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Mode Toggle & Parameters -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Creation Mode:" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <RadioButton Name="UniformRadio" Content="Uniform Spacing" IsChecked="True" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <RadioButton Name="CustomRadio" Content="Custom per Level" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Uniform Mode Controls -->
                <StackPanel Name="UniformPanel" Visibility="Visible">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Offset per Level (mm):" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="OffsetInput" Text="3000" Height="28" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Number of Levels:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="CountInput" Text="3" Height="28" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Name Prefix:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="PrefixInput" Text="Level " Height="28" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Direction:" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton Name="AboveRadio" Content="Above (+)" IsChecked="True" Margin="0,0,12,0"/>
                                <RadioButton Name="BelowRadio" Content="Below (-)"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Custom Mode Controls -->
                <StackPanel Name="CustomPanel" Visibility="Collapsed">
                    <TextBlock Text="Enter Level Name and Offset from Reference Level (mm):" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="CustomNameInput" Height="28" VerticalContentAlignment="Center" Padding="4,0,4,0" ToolTip="Level Name" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Name="CustomOffsetInput" Text="3000" Height="28" VerticalContentAlignment="Center" Padding="4,0,4,0" ToolTip="Offset in mm (+/-)" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Name="AddCustomRowBtn" Content="➕ Add" Style="{StaticResource ModernButton}" Height="28"/>
                    </Grid>

                    <Border BorderBrush="#E5E7EB" BorderThickness="1" Height="100" CornerRadius="4">
                        <ListView Name="CustomLevelsList" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Offset (mm)" Width="120" DisplayMemberBinding="{Binding OffsetMm}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Name="RemoveCustomRowBtn" Content="🗑️ Remove Selected" Style="{StaticResource DangerButton}" Height="26" FontSize="11" Margin="0,0,6,0"/>
                        <Button Name="ClearCustomRowsBtn" Content="🧹 Clear All" Style="{StaticResource ModernButton}" Height="26" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Preview Section -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Computed Levels Preview:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    <Button Name="PreviewBtn" Content="🔄 Refresh Preview" Style="{StaticResource ModernButton}" Height="26" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>

                <ListView Grid.Row="1" Name="PreviewList" BorderThickness="1" BorderBrush="#E5E7EB">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}"/>
                            <GridViewColumn Header="Level Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Absolute Elev (mm)" Width="130" DisplayMemberBinding="{Binding ElevMm}"/>
                            <GridViewColumn Header="Relative to Ref (mm)" Width="130" DisplayMemberBinding="{Binding RelOffsetMm}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="CreateBtn" Content="🚀 Create Levels" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="130"/>
                <Button Name="CancelBtn" Content="Cancel" Style="{StaticResource ModernButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>