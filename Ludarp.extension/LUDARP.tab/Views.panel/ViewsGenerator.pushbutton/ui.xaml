<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📐 BIMToolkit — Views Generator"
        Height="750" Width="660"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E4E8"/>
            <Setter Property="Foreground" Value="#24292E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Field Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="📐 Multi-Discipline Views Generator" FontSize="18" FontWeight="Bold" Foreground="#1A1A1A"/>
            <TextBlock Text="Generate Floor Plans &amp; Reflected Ceiling Plans (RCP) with industry standard naming conventions." FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Levels Selection List -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Select Target Levels (Multi-select):" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="SelectAllLevelsBtn" Content="Select All" Style="{StaticResource ModernButton}" Height="22" FontSize="11" Margin="0,0,4,0"/>
                        <Button Name="SelectNoneLevelsBtn" Content="Deselect All" Style="{StaticResource ModernButton}" Height="22" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" Name="LevelsListView" SelectionMode="Multiple" BorderThickness="1" BorderBrush="#E5E7EB">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Level Name" Width="270" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Elevation (mm)" Width="150" DisplayMemberBinding="{Binding ElevMm}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Discipline View Types: Floor Plans & Ceiling Plans for ALL -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Disciplines &amp; View Types to Create:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="CheckAllViewsBtn" Content="Check All" Style="{StaticResource ModernButton}" Height="20" FontSize="10" Margin="0,0,4,0"/>
                        <Button Name="UncheckAllViewsBtn" Content="Uncheck All" Style="{StaticResource ModernButton}" Height="20" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Arch & Struct -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="🏛️ Architecture" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,2"/>
                        <CheckBox Name="ArchFloorPlanCB" Content="Floor Plan" IsChecked="True" Margin="2,1,0,1"/>
                        <CheckBox Name="ArchCeilingPlanCB" Content="Ceiling Plan (RCP)" IsChecked="False" Margin="2,1,0,6"/>

                        <TextBlock Text="🏢 Structural" FontWeight="Bold" Foreground="#D9381E" Margin="0,2,0,2"/>
                        <CheckBox Name="StructPlanCB" Content="Structural Plan" IsChecked="True" Margin="2,1,0,1"/>
                        <CheckBox Name="StructCeilingPlanCB" Content="Soffit / Ceiling Plan" IsChecked="False" Margin="2,1,0,2"/>
                    </StackPanel>

                    <!-- Column 2: Mech & Elec -->
                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                        <TextBlock Text="❄️ Mechanical (HVAC)" FontWeight="Bold" Foreground="#107C41" Margin="0,0,0,2"/>
                        <CheckBox Name="MechPlanCB" Content="Mech Floor Plan" IsChecked="True" Margin="2,1,0,1"/>
                        <CheckBox Name="MechCeilingPlanCB" Content="Mech Ceiling (Diffusers)" IsChecked="False" Margin="2,1,0,6"/>

                        <TextBlock Text="⚡ Electrical" FontWeight="Bold" Foreground="#D83B01" Margin="0,2,0,2"/>
                        <CheckBox Name="ElecPlanCB" Content="Elec Floor (Power)" IsChecked="True" Margin="2,1,0,1"/>
                        <CheckBox Name="ElecCeilingPlanCB" Content="Elec Ceiling (Lighting)" IsChecked="False" Margin="2,1,0,2"/>
                    </StackPanel>

                    <!-- Column 3: Plumbing & Coordination -->
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="🚰 Plumbing" FontWeight="Bold" Foreground="#004E8C" Margin="0,0,0,2"/>
                        <CheckBox Name="PlumbPlanCB" Content="Plumbing Floor Plan" IsChecked="False" Margin="2,1,0,6"/>

                        <TextBlock Text="🌐 Coordination" FontWeight="Bold" Foreground="#6B21A8" Margin="0,2,0,2"/>
                        <CheckBox Name="CoordPlanCB" Content="Coordination Plan" IsChecked="False" Margin="2,1,0,1"/>
                        <CheckBox Name="CoordCeilingPlanCB" Content="Coordination RCP" IsChecked="False" Margin="2,1,0,2"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Naming Conventions & Options -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Naming Scheme Preset Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Naming Standard / Preset:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Name="NamingSchemeCombo" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick Checkbox: Force UPPERCASE -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,14,4,0">
                        <CheckBox Name="ForceUppercaseCB" Content="FORCE UPPERCASE" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>

                    <!-- Update Preview Button -->
                    <Button Grid.Column="2" Name="RefreshPreviewBtn" Content="🔄 Update Preview" Style="{StaticResource ModernButton}" Height="24" FontSize="11" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Pattern Input Panel (Visible for Standard / Custom schemes) -->
                <StackPanel Name="PatternInputPanel" Visibility="Visible" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Pattern Template: (Tokens: [discipline], [type], [level], [seq])" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="NamingPatternInput" Height="24" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                            <TextBlock Text="Prefix (Optional):" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="PrefixInput" Height="24" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Suffix (Optional):" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="SuffixInput" Height="24" VerticalContentAlignment="Center" Padding="4,0,4,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ISO 19650 Settings Panel (Visible when ISO scheme selected) -->
                <StackPanel Name="IsoNamingPanel" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                            <TextBlock Text="Project Code:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="IsoProjectInput" Text="PRJ" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="Originator:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="IsoOriginatorInput" Text="ARC" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="3,0,3,0">
                            <TextBlock Text="Zone / Vol:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="IsoZoneInput" Text="ZZ" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="3,0,3,0">
                            <TextBlock Text="Start Seq #:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="IsoSeqInput" Text="0001" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="3,0,0,0">
                            <TextBlock Text="Delimiter:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="IsoSepInput" Text="-" Height="24" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="* ISO 19650: [Project]-[Originator]-[Zone]-[Level]-[Type]-[Role]-[Seq] (e.g. PRJ-ARC-ZZ-01-PL-A-0001)" Foreground="#666666" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Preview Grid -->
        <Border Grid.Row="4" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Generated Views Preview:" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <ListView Grid.Row="1" Name="PreviewListView" BorderThickness="1" BorderBrush="#E5E7EB">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="35" DisplayMemberBinding="{Binding Index}"/>
                            <GridViewColumn Header="Proposed View Name" Width="260" DisplayMemberBinding="{Binding ProposedName}"/>
                            <GridViewColumn Header="Discipline" Width="90" DisplayMemberBinding="{Binding Discipline}"/>
                            <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding ViewType}"/>
                            <GridViewColumn Header="Level" Width="100" DisplayMemberBinding="{Binding LevelName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="GenerateBtn" Content="🚀 Generate Views" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="140"/>
                <Button Name="CancelBtn" Content="Cancel" Style="{StaticResource ModernButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>